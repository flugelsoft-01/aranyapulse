{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aranyapulse",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-05-01",
  "assets": {
    "directory": "./frontend/out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
